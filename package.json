{
  "name": "missao-aos-povos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bootstrap": "node --env-file=.env.local --import tsx scripts/bootstrap-admin.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "format": "prettier --write src scripts tests",
    "test:firebase": "firebase emulators:exec --config firebase.emulators.json --only firestore,auth,storage --project demo-mychurch \"node --import tsx --test tests/firebase.test.ts\""
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "firebase": "^12.19.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
