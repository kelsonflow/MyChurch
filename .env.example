NEXT_PUBLIC_SITE_URL=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Chave pública da aplicação Web Firebase, usada no servidor para login e emails.
FIREBASE_WEB_API_KEY=
# Apenas desenvolvimento: caminho para ADC autorizado, nunca enviar ao Git.
# GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/credenciais-privadas.json
# Em produção utiliza-se a conta técnica do Cloud Run, sem ficheiro de chave.
CONTACT_HASH_SECRET=
# Notificação opcional de novas mensagens; o envio de acesso usa o Firebase.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=
